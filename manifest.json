{
  "manifest_version": 3,
  "name": "高規格道路",
  "version": "2.6.9",
  "description": "世界最高レベルの道路を誇る高規格道路で、速度を守りながら、楽しく走行できます。",
  "icons": {
    "16": "assets/img/icon16.png",
    "48": "assets/img/icon48.png",
    "128": "assets/img/icon128.png"
  },
  "offline_enabled": false,
  "content_scripts": [
    {
      "matches": [
        "https://*.mc2.osakac.ac.jp/*"
      ],
      "js": [
        "moodle/etc-images.js",
        "moodle/etc-answer.js",
        "moodle/moodle-ai-content.js"
      ],
      "css": [
        "moodle/content-style.css"
      ]
    },
    {
      "matches": [
        "https://*.mc2.osakac.ac.jp/*"
      ],
      "js": [
        "shared/moodle-departments.js",
        "moodle/button.js"
      ]
    },
    {
      "matches": [
        "https://*.mc2.osakac.ac.jp/*/login/index.php*",
        "https://*.mc2.osakac.ac.jp/login/index.php*"
      ],
      "js": [
        "moodle/login.js"
      ]
    },
    {
      "matches": [
        "https://*.mc2.osakac.ac.jp/*/mod/assign/view.php?id=*",
        "https://*.mc2.osakac.ac.jp/*/mod/quiz/view.php?id=*",
        "https://*.mc2.osakac.ac.jp/*/mod/feedback/view.php?id=*"
      ],
      "js": [
        "moodle/assign.js"
      ]
    },
    {
      "matches": [
        "https://*.mc2.osakac.ac.jp/*/*"
      ],
      "js": [
        "shared/timetable-storage.js",
        "moodle/timetable-content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "webRequest"
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://auth.openai.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "chat/chat-panel.html"
  },
  "background": {
    "service_worker": "background/chat-worker.mjs",
    "type": "module"
  }
}
